# Google OAuth & Domain Protection Layer for Hussh Matrix Dashboard
# Get your Google Client ID from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_ID=""
# Allowed email domains (comma-separated). Users signing in with these domains will be granted access.
ALLOWED_EMAIL_DOMAINS="hushh.ai,hushhtech.com,hushh.labs"
# Allowed explicit email addresses (comma-separated) outside the allowed domains.
ALLOWED_EMAILS=""
# Set to true to enforce OAuth protection on dashboard routes and API endpoints.
REQUIRE_AUTH=true

# GEMINI_API_KEY: Required for server-side Gemini AI calls by Hussh Insights AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3001"

# Server port for the Express backend
PORT=3001

# Server-side Gemini metrics analyst config. In production, store the real key
# in Secret Manager as hushh-gemini-api-key.
GEMINI_METRICS_CHAT_MODEL="gemini-2.5-flash"
METRICS_CHAT_RATE_LIMIT_HOURLY=60
METRICS_CHAT_RATE_LIMIT_DAILY=300
METRICS_CHAT_REQUEST_TIMEOUT_MS=45000
METRICS_CHAT_CONTEXT_CACHE_SECONDS=30

# BigQuery UAT feed (active with real data)
BQ_UAT_PROJECT="hushh-pda-uat"
BQ_UAT_DATASET="analytics_public"
BQ_UAT_VIEW="kai_public_dashboard_feed"

# BigQuery Production feed (status-only until GA4 export materializes)
BQ_PROD_PROJECT="hushh-pda"
BQ_PROD_DATASET="analytics_public"
BQ_PROD_VIEW="kai_public_dashboard_feed"

# Optional: BigQuery project used to create query jobs.
# Set this if your ADC identity can read the feed datasets but does not have
# bigquery.jobs.create on the feed projects themselves.
BQ_JOB_PROJECT=""

# Optional: allow the local Express proxy to fall back to the authenticated
# bq CLI when Application Default Credentials do not match gcloud CLI auth.
BQ_CLI_FALLBACK=true

# hushhtech.com public aggregate metrics endpoint (canonical production domain)
HUSHHTECH_ANALYTICS_ENDPOINT="https://hushhtech.com/api/metrics/summary"
HUSHHTECH_METRICS_WINDOW_DAYS=7
HUSHHTECH_GCP_PROJECT="hushh-tech-prod"
HUSHHTECH_CLOUD_RUN_SERVICE="hushh-tech-website"
HUSHHTECH_CLOUD_RUN_REGION="us-central1"
HUSHHTECH_SEARCH_PROJECT="hushh-ai-prod"
HUSHHTECH_SEARCH_DATASET="searchconsole_hushhtech_com"
HUSHHTECH_SEARCH_FALLBACK_PROJECT="hushh-ai-prod"
HUSHHTECH_SEARCH_FALLBACK_DATASET="hushhtech_search_console_api"
HUSHHTECH_SEARCH_CONSOLE_SITE_URL="sc-domain:hushhtech.com"
HUSHHTECH_SEARCH_CONSOLE_TYPE="web"
HUSHHTECH_SEARCH_CONSOLE_DATA_STATE="all"
HUSHHTECH_SEARCH_CONSOLE_ROW_LIMIT=10
# Server-side OAuth JSON for the Cloud Run Job only. Store the real value in
# Secret Manager as hushhtech-search-console-oauth.
HUSHHTECH_SEARCH_CONSOLE_OAUTH_JSON=""

# One GA4 export + realtime properties. Numeric property IDs are for the
# server-side GA4 Data API; dataset IDs are for delayed BigQuery exports.
ONE_UAT_GA4_PROJECT="hushh-pda-uat"
ONE_UAT_GA4_DATASET="analytics_533362555"
ONE_UAT_GA4_PROPERTY_ID="533362555"
ONE_PROD_GA4_PROJECT="hushh-pda"
ONE_PROD_GA4_DATASET="analytics_526603671"
ONE_PROD_GA4_PROPERTY_ID="526603671"
ONE_GA4_WINDOW_DAYS=14

# One production infrastructure metrics. Backend routing is not changed by
# these analytics settings.
ONE_PROD_GCP_PROJECT="hushh-pda"
ONE_PROD_CLOUD_RUN_SERVICE="hushh-webapp"
ONE_PROD_METRICS_WINDOW_DAYS=7

# One Search Console. The fallback dataset retains its historical internal
# name so existing aggregate history is not discarded during the rename.
ONE_SEARCH_PROJECT="hushh-pda"
ONE_SEARCH_DATASET="searchconsole_searchconsole_hushh_ai"
ONE_SEARCH_FALLBACK_PROJECT="hushh-ai-prod"
ONE_SEARCH_FALLBACK_DATASET="kai_search_console_api"
ONE_SEARCH_CONSOLE_SITE_URL="sc-domain:hushh.ai"
ONE_SEARCH_CONSOLE_PAGE_FILTER_REGEX="^https://(uat\\.)?one\\.hushh\\.ai(/|$)"
ONE_PROD_SEARCH_CONSOLE_PAGE_FILTER_REGEX="^https://one\\.hushh\\.ai(/|$)"
ONE_UAT_SEARCH_CONSOLE_PAGE_FILTER_REGEX="^https://uat\\.one\\.hushh\\.ai(/|$)"
ONE_SEARCH_CONSOLE_TYPE="web"
ONE_SEARCH_CONSOLE_DATA_STATE="all"
ONE_SEARCH_CONSOLE_ROW_LIMIT=10

# hushh.ai Cloud Run and Search Console export summaries
HUSHH_AI_GCP_PROJECT="hushh-ai-prod"
HUSHH_AI_CLOUD_RUN_SERVICE="hushh-ai-website"
HUSHH_AI_METRICS_WINDOW_DAYS=7
HUSHH_AI_SEARCH_PROJECT="hushh-pda"
HUSHH_AI_SEARCH_DATASET="searchconsole_searchconsole_hushh_ai"
HUSHH_AI_GA4_MEASUREMENT_ID="G-PPEF1CSJ5H"
# Numeric GA4 property ID from Google Analytics Admin > Property details.
# GA4 Data API calls use this numeric property ID, not the measurement ID.
HUSHH_AI_GA4_PROPERTY_ID=""
# Optional bridge when Analytics authorizes a different GCP service account.
HUSHH_AI_GA4_IMPERSONATE_SERVICE_ACCOUNT=""

# hushhtech.com Supabase database aggregates.
HUSHHTECH_SUPABASE_PROJECT_REF="ibsisfnjxeowvdtvgzff"
# Server-side Supabase management token for hushhtech.com aggregate-only database counts.
# Do not expose this in the browser or commit a real value.
HUSHHTECH_SUPABASE_ACCESS_TOKEN=""

# Google Cloud credentials — uses Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# Or set: GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# App Store Connect — Hushh 1 iOS (official Analytics Reports + TestFlight
# REST/metrics APIs, no scraping). Create an API key at App Store Connect >
# Users and Access > Integrations > App Store Connect API.
# - Production (Analytics Reports): an Admin-role key is required to request
#   a new report type the first time; after that, Sales and Reports or
#   Finance can list and download the generated reports.
# - TestFlight/UAT (beta testers, beta build/tester usage metrics, beta
#   feedback): permissions are gated per-resource and are not uniform across
#   them; check each endpoint's own documented role requirement rather than
#   assuming one role covers all of TestFlight.
# https://developer.apple.com/documentation/appstoreconnectapi/generating-tokens-for-api-requests
APP_STORE_CONNECT_KEY_ID=""
APP_STORE_CONNECT_ISSUER_ID=""
# Either the .p8 private key contents ("\n" accepted in place of real
# newlines) or, preferably for local dev, a filesystem path to the .p8 file
# kept outside the repo -- PRIVATE_KEY_PATH is read straight off disk and
# takes precedence over PRIVATE_KEY when both are set, so the key material
# never has to sit in this file at all. Store the real value in Secret
# Manager as app-store-connect-private-key for deployed environments.
APP_STORE_CONNECT_PRIVATE_KEY=""
APP_STORE_CONNECT_PRIVATE_KEY_PATH=""
APP_STORE_CONNECT_APP_ID="6757718917"
APP_STORE_CONNECT_WINDOW_DAYS=90
