# GEMINI_API_KEY: Required for server-side Gemini AI calls by Hussh Insights AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3001"

# Server port for the Express backend
PORT=3001

# Server-side Gemini metrics analyst config. In production, store the real key
# in Secret Manager as hushh-gemini-api-key.
GEMINI_METRICS_CHAT_MODEL="gemini-2.5-flash"
METRICS_CHAT_RATE_LIMIT_HOURLY=60
METRICS_CHAT_RATE_LIMIT_DAILY=300
METRICS_CHAT_REQUEST_TIMEOUT_MS=45000
METRICS_CHAT_CONTEXT_CACHE_SECONDS=30

# BigQuery UAT feed (active with real data)
BQ_UAT_PROJECT="hushh-pda-uat"
BQ_UAT_DATASET="analytics_public"
BQ_UAT_VIEW="kai_public_dashboard_feed"

# BigQuery Production feed (status-only until GA4 export materializes)
BQ_PROD_PROJECT="hushh-pda"
BQ_PROD_DATASET="analytics_public"
BQ_PROD_VIEW="kai_public_dashboard_feed"

# Optional: BigQuery project used to create query jobs.
# Set this if your ADC identity can read the feed datasets but does not have
# bigquery.jobs.create on the feed projects themselves.
BQ_JOB_PROJECT=""

# Optional: allow the local Express proxy to fall back to the authenticated
# bq CLI when Application Default Credentials do not match gcloud CLI auth.
BQ_CLI_FALLBACK=true

# hushhtech.com public aggregate metrics endpoint (canonical production domain)
HUSHHTECH_ANALYTICS_ENDPOINT="https://hushhtech.com/api/metrics/summary"
HUSHHTECH_METRICS_WINDOW_DAYS=7
HUSHHTECH_GCP_PROJECT="hushh-tech-prod"
HUSHHTECH_CLOUD_RUN_SERVICE="hushh-tech-website"
HUSHHTECH_CLOUD_RUN_REGION="us-central1"
HUSHHTECH_SEARCH_PROJECT="hushh-ai-prod"
HUSHHTECH_SEARCH_DATASET="searchconsole_hushhtech_com"
HUSHHTECH_SEARCH_FALLBACK_PROJECT="hushh-ai-prod"
HUSHHTECH_SEARCH_FALLBACK_DATASET="hushhtech_search_console_api"
HUSHHTECH_SEARCH_CONSOLE_SITE_URL="sc-domain:hushhtech.com"
HUSHHTECH_SEARCH_CONSOLE_TYPE="web"
HUSHHTECH_SEARCH_CONSOLE_DATA_STATE="all"
HUSHHTECH_SEARCH_CONSOLE_ROW_LIMIT=10
# Server-side OAuth JSON for the Cloud Run Job only. Store the real value in
# Secret Manager as hushhtech-search-console-oauth.
HUSHHTECH_SEARCH_CONSOLE_OAUTH_JSON=""

# Kai raw GA4 export summary
KAI_GA4_PROJECT="hushh-pda-uat"
KAI_GA4_DATASET="analytics_533362555"
KAI_GA4_WINDOW_DAYS=14

# Kai production product metrics
KAI_PROD_GA4_PROJECT="hushh-pda"
KAI_PROD_GA4_DATASET="analytics_526603671"
KAI_PROD_GCP_PROJECT="hushh-pda"
KAI_PROD_CLOUD_RUN_SERVICE="hushh-webapp"
KAI_PROD_METRICS_WINDOW_DAYS=7

# hushh.ai Cloud Run and Search Console export summaries
HUSHH_AI_GCP_PROJECT="hushh-ai-prod"
HUSHH_AI_CLOUD_RUN_SERVICE="hushh-ai-website"
HUSHH_AI_METRICS_WINDOW_DAYS=7
HUSHH_AI_SEARCH_PROJECT="hushh-pda"
HUSHH_AI_SEARCH_DATASET="searchconsole_searchconsole_hushh_ai"
HUSHH_AI_GA4_MEASUREMENT_ID="G-PPEF1CSJ5H"
# Numeric GA4 property ID from Google Analytics Admin > Property details.
# GA4 Data API calls use this numeric property ID, not the measurement ID.
HUSHH_AI_GA4_PROPERTY_ID=""
# Optional bridge when Analytics authorizes a different GCP service account.
HUSHH_AI_GA4_IMPERSONATE_SERVICE_ACCOUNT=""

# hushhtech.com Supabase database aggregates.
HUSHHTECH_SUPABASE_PROJECT_REF="ibsisfnjxeowvdtvgzff"
# Server-side Supabase management token for hushhtech.com aggregate-only database counts.
# Do not expose this in the browser or commit a real value.
HUSHHTECH_SUPABASE_ACCESS_TOKEN=""

# Google Cloud credentials — uses Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# Or set: GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
